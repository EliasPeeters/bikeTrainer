{
  "manifest_version": "0.3",
  "name": "wattwerk",
  "display_name": "Wattwerk",
  "version": "0.1.0",
  "description": "Trainingsprogramme, Verlauf und Sammlungen aus Wattwerk – lesen, suchen und anlegen.",
  "long_description": "Verbindet Claude mit deinem Wattwerk-Konto: gefahrene Einheiten und Wochenbelastung lesen, die Bibliothek durchsuchen, eigene Trainingsprogramme anlegen und ändern, Sammlungen pflegen und das Fahrerprofil sehen. Zwanzig Werkzeuge, eins je Route der Wattwerk-API.\n\nZum Verbinden brauchst du einen Zugangsschlüssel: im Wattwerk-Portal unter Profil → Zugangsschlüssel anlegen und hier eintragen. Der Schlüssel lässt sich jederzeit einzeln zurücknehmen und wahlweise auf Lesen beschränken.",
  "author": {
    "name": "Elias Peeters"
  },
  "homepage": "https://wattwerk.eliaspeeters.de",
  "documentation": "https://github.com/EliasPeeters/bikeTrainer/blob/main/docs/MCP.md",
  "support": "https://github.com/EliasPeeters/bikeTrainer/issues",
  "icon": "icon.png",
  "server": {
    "type": "node",
    "entry_point": "server/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/server/index.js"],
      "env": {
        "WATTWERK_API_KEY": "${user_config.api_key}",
        "WATTWERK_API_URL": "${user_config.api_url}"
      }
    }
  },
  "user_config": {
    "api_key": {
      "type": "string",
      "title": "Zugangsschlüssel",
      "description": "Aus dem Wattwerk-Portal unter Profil → Zugangsschlüssel. Beginnt mit wk_",
      "sensitive": true,
      "required": true
    },
    "api_url": {
      "type": "string",
      "title": "Adresse der API",
      "description": "Nur ändern, wenn du eine eigene Wattwerk-Installation betreibst.",
      "default": "https://api.wattwerk.eliaspeeters.de",
      "required": false
    }
  },
  "tools": [
    {"name": "list_my_workouts", "description": "Eigene Trainingsprogramme"},
    {"name": "search_workouts", "description": "Öffentliche Programme und Katalog durchsuchen"},
    {"name": "get_workout", "description": "Ein Programm mit allen Blöcken"},
    {"name": "create_workout", "description": "Neues Programm anlegen"},
    {"name": "update_workout", "description": "Eigenes Programm ändern"},
    {"name": "delete_workout", "description": "Programm löschen"},
    {"name": "import_workouts", "description": "Mehrere Programme auf einmal"},
    {"name": "browse_library", "description": "Die Reihen der Bibliothek"},
    {"name": "list_collections", "description": "Eigene Sammlungen"},
    {"name": "create_collection", "description": "Sammlung anlegen"},
    {"name": "update_collection", "description": "Sammlung ändern"},
    {"name": "delete_collection", "description": "Sammlung löschen"},
    {"name": "add_workout_to_collection", "description": "Programm in eine Sammlung legen"},
    {"name": "remove_workout_from_collection", "description": "Programm aus einer Sammlung nehmen"},
    {"name": "list_sessions", "description": "Gefahrene Einheiten und Wochenbelastung"},
    {"name": "log_session", "description": "Einheit nachtragen"},
    {"name": "delete_session", "description": "Einheit löschen"},
    {"name": "get_profile", "description": "Fahrerprofil: FTP, Gewicht, Herzfrequenzen"},
    {"name": "update_profile", "description": "Profilwerte ändern"},
    {"name": "api_health", "description": "Antwortet die API?"}
  ],
  "keywords": ["cycling", "training", "indoor", "workout", "wattwerk"],
  "license": "UNLICENSED",
  "compatibility": {
    "platforms": ["darwin", "win32", "linux"],
    "runtimes": {
      "node": ">=18.0.0"
    }
  }
}
