server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Die API liegt hinter derselben Herkunft wie die Seite. Damit braucht der
    # Browser kein CORS, und in das gebaute JavaScript muss keine Adresse
    # einkompiliert werden.
    location /api/ {
        proxy_pass ${API_URL}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Die Ratenbegrenzung der API liest diesen Header - ohne ihn zaehlen
        # alle Registrierungen auf die IP des Proxys.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Einstiegspunkt fuer alles andere: die Seite ist eine Single-Page-App.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Vite haengt einen Hash an jeden Dateinamen, also darf alles darunter
    # beliebig lange im Cache bleiben.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Die Aufnahmen der App machen den Großteil der Seitengröße aus. Ihre Namen
    # tragen keinen Hash, darum ein Tag statt eines Jahres.
    location /shots/ {
        add_header Cache-Control "public, max-age=86400";
    }
}
