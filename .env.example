# Vorlage. Für den lokalen Stack braucht es keine .env - alle Werte haben
# Standardwerte (packages/backend/src/config/env.ts).

# Host-Ports. Standardwerte sind so gewählt, dass sie neben den üblichen
# Entwicklungsdiensten frei bleiben.
API_PORT=8088
DB_PORT=3307
LANDINGPAGE_PORT=8089

# Wohin die Landingpage ihre /api-Aufrufe weiterreicht.
API_URL=http://host.docker.internal:8088

# In Produktion Pflicht: mit den Standardwerten verweigert der Server bei
# NODE_ENV=production den Start.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
BASE_URL=https://api.wattwerk.example

# Ratenbegrenzung der Anmelderouten, je IP.
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW_MS=3600000
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MS=60000
