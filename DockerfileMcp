# syntax=docker/dockerfile:1

# Mehrstufiger Bau fuer @wattwerk/mcp im HTTP-Betrieb.
#
# Gebaut wird `serve.js` - der stdio-Einstieg hat im Container nichts zu suchen,
# weil dort niemand an stdin haengt. Aufgebaut wie DockerfileBackend, damit
# beide Images sich gleich verhalten.

# ---------- Stufe 1: Abhaengigkeiten ----------
FROM node:20-alpine AS deps

WORKDIR /mcp

# Nur die Manifeste, damit diese Schicht im Cache bleibt, solange sich die
# Abhaengigkeiten nicht aendern. Alle Workspace-Manifeste muessen dabei sein -
# yarn loest den Workspace sonst anders auf als die Lockfile es festhaelt.
COPY package.json yarn.lock ./
COPY packages/shared/package.json packages/shared/package.json
COPY packages/backend/package.json packages/backend/package.json
COPY packages/landingpage/package.json packages/landingpage/package.json
COPY packages/mcp/package.json packages/mcp/package.json

RUN yarn install --frozen-lockfile

# ---------- Stufe 2: Bauen ----------
FROM deps AS builder

COPY tsconfig.base.json tsconfig.base.json
COPY packages/shared packages/shared
COPY packages/mcp packages/mcp

# esbuild loest @wattwerk/shared auf die Quelle auf, deshalb wird sie hier
# gebraucht - im Laufzeit-Image dann nicht mehr.
RUN yarn workspace @wattwerk/mcp build

# ---------- Stufe 3: Laufzeit ----------
FROM node:20-alpine AS runtime

WORKDIR /mcp

COPY package.json yarn.lock ./
COPY packages/shared/package.json packages/shared/package.json
COPY packages/backend/package.json packages/backend/package.json
COPY packages/landingpage/package.json packages/landingpage/package.json
COPY packages/mcp/package.json packages/mcp/package.json

# NODE_ENV nur fuer diesen Befehl, nicht als ENV: sonst stuende die Variable
# auch zur Laufzeit auf "production", und der lokale Stack koennte sie nicht
# mehr auf "development" setzen.
RUN NODE_ENV=production yarn install --frozen-lockfile && yarn cache clean

COPY --from=builder /mcp/packages/mcp/dist packages/mcp/dist

USER node
EXPOSE 8090

CMD ["node", "packages/mcp/dist/serve.js"]
